{
  "functions": {
    "api/og.js": {
      "includeFiles": "api/fonts/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/join/:code",
      "destination": "/api/join?code=:code"
    },
    {
      "source": "/calendar/:token/pickem.ics",
      "destination": "https://sxktvztljzxcmhezphsq.supabase.co/functions/v1/calendar?token=:token"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
